{
  "name": "video-dataset-tagger-extension",
  "version": "1.0.0",
  "description": "Universal Video Segment Tagger — Microsoft Edge Extension",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build:sidepanel": "tsc && vite build",
    "build:content": "esbuild src/content/video-detector.ts --bundle --outfile=dist/content.js --format=iife",
    "build:background": "esbuild src/background/service-worker.ts --bundle --outfile=dist/background.js --format=esm --target=es2022",
    "build": "npm run build:sidepanel && npm run build:content && npm run build:background",
    "test": "vitest run"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "idb": "^8.0.0",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  }
}
