# Security and API Key
API_KEY=test_dev_key

# Database Connection (SQLite default or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./storage/tagger.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tagger_db

# Redis Connection (For Celery distributed processing)
REDIS_URL=redis://localhost:6379/0

# Storage Directories
DATASET_DIR=./dataset
BASE_STORAGE_DIR=./storage
TEMP_DIR=./storage/temp

# Resource and Security Limits
MAX_DOWNLOAD_SIZE_BYTES=5368709120
MAX_DURATION_SECONDS=14400
MAX_SEGMENTS_PER_JOB=500
DOWNLOAD_TIMEOUT_SECONDS=600

# Anti-SSRF toggle (Must remain false in production)
ALLOW_LOCAL_NETWORK=false

# Accurate cutting using FFmpeg re-encoding
ACCURATE_CUTTING=true

# Celery vs In-Process Worker
CELERY_ENABLED=false
CONCURRENT_WORKERS=2
