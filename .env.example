# ========================================
# Video Dataset Tagger - Environment Variables
# ========================================
# For Coolify: Add these directly to your project's Environment Variables panel.

# Security
# Admin key for the dashboard. Use a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If left empty, the server generates one on first start, prints it in the log
# and stores it in <storage>/admin_key.txt.
# Extensions should NOT use this key: generate a client key for each one in the
# dashboard under "System & connection".
API_KEY=

# Optional Configurations (Defaults are usually fine for Coolify)
# DATABASE_URL=sqlite+aiosqlite:////app/storage/tagger.db
# ALLOW_LOCAL_NETWORK=false
# CELERY_ENABLED=false
# DOWNLOAD_STALL_TIMEOUT_SECONDS=180
# MAX_DOWNLOAD_SIZE_BYTES=5368709120
