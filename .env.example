# ========================================
# Video Dataset Tagger - Environment Variables
# ========================================
# For Coolify: Add these directly to your project's Environment Variables panel.

# Security
# Change this to a secure random string! The extension needs this to authenticate.
API_KEY=test_dev_key

# Optional Configurations (Defaults are usually fine for Coolify)
# DATABASE_URL=sqlite+aiosqlite:////app/storage/tagger.db
# ALLOW_LOCAL_NETWORK=false
# CELERY_ENABLED=false
